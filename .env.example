# ============================================================
# BTC Exchange - 根目錄環境變量（供 docker-compose 注入後端）
# 複製為 .env 並填寫；後端容器會優先使用 backend/.env
# ============================================================
# 數據庫（可選，與 backend/.env 一致時可不設）
# DB_USER=postgres
# DB_PASSWORD=postgres123
# DB_NAME=btc_exchange

# 雙鏈 RPC（與 backend/.env 一致即可實現雙鏈自動收割）
ETH_HTTP=https://your-quicknode-eth-http-url
ETH_WSS=wss://your-quicknode-eth-wss-url
TRON_HTTP=https://api.trongrid.io
TRON_API_KEY=your-trongrid-api-key
