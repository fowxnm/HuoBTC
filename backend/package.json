{
  "name": "btc-exchange-backend",
  "version": "2.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "ws": "bun run src/websocket/marketDataServer.ts",
    "worker": "bun run src/workers/walletStateSync.ts",
    "worker:ledger": "bun run src/workers/ledgerReconciliation.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:admins": "bun run src/db/seedAdmins.ts",
    "db:push": "drizzle-kit push pg",
    "test:chain": "bun run src/test/fullChainSimulation.ts",
    "setup:production": "bun run src/scripts/setup-production.ts",
    "seed-admins": "bun run src/scripts/seed-admins.ts"
  },
  "dependencies": {
    "@elysiajs/cookie": "latest",
    "@elysiajs/cors": "^1.0.0",
    "@elysiajs/jwt": "^1.0.0",
    "@elysiajs/static": "^1.0.0",
    "@elysiajs/swagger": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "bignumber.js": "^9.1.2",
    "ccxt": "^4.2.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.0.0",
    "ethers": "^6.9.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.3",
    "telegraf": "^4.15.0",
    "tronweb": "^5.3.0",
    "viem": "^2.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "bun-types": "latest"
  }
}
